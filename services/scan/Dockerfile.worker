# Dockerfile du Worker.
# Build depuis la RACINE du projet : docker build -f services/scan/Dockerfile.worker .

FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Binaires Gitleaks et Trivy dans /app/bin — chemin précis nécessaire
# car gitleaks_runner.py/trivy_runner.py calculent leur emplacement par
# défaut via Path(__file__).parent.parent.parent, et le code sera copié
# dans /app/services/scan/. Trois niveaux au-dessus = /app.
RUN mkdir -p bin && \
    curl -sL -o /tmp/gitleaks.tar.gz https://github.com/gitleaks/gitleaks/releases/download/v8.21.2/gitleaks_8.21.2_linux_x64.tar.gz && \
    tar -xzf /tmp/gitleaks.tar.gz -C bin gitleaks && \
    rm /tmp/gitleaks.tar.gz && \
    chmod +x bin/gitleaks && \
    curl -sL -o /tmp/trivy.tar.gz https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz && \
    tar -xzf /tmp/trivy.tar.gz -C bin trivy && \
    rm /tmp/trivy.tar.gz && \
    chmod +x bin/trivy

COPY services/scan/requirements-worker.txt services/scan/requirements-worker.txt
RUN pip install --no-cache-dir -r services/scan/requirements-worker.txt

COPY services/scan/ services/scan/

WORKDIR /app/services/scan

CMD ["python3", "worker.py"]
