# Dockerfile de l'API Scan Service.
# Build depuis la RACINE du projet : docker build -f services/scan/Dockerfile.api .
#
# Volontairement LÉGER : ce conteneur n'exécute jamais les scanners
# directement — depuis le refactor asynchrone de la Phase 4, c'est le
# Worker qui s'en charge.

FROM python:3.12-slim

WORKDIR /app/services/scan

COPY services/scan/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY services/scan/ .

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
